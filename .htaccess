DirectoryIndex index.html

AddType text/markdown .md

<IfModule mod_rewrite.c>
	RewriteEngine On

	RewriteCond %{HTTP:Accept} text/markdown [NC]
	RewriteRule ^$ index.md [L,T=text/markdown]

	RewriteCond %{HTTP:Accept} text/markdown [NC]
	RewriteRule ^index\.html$ index.md [L,T=text/markdown]

	RewriteCond %{HTTP:Accept} text/markdown [NC]
	RewriteRule ^aviso-legal\.html$ aviso-legal.md [L,T=text/markdown]

	RewriteCond %{HTTP:Accept} text/markdown [NC]
	RewriteRule ^privacidad\.html$ privacidad.md [L,T=text/markdown]
</IfModule>

<IfModule mod_headers.c>
	Header merge Vary Accept
</IfModule>